rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The app does not currently use Firebase Storage — deny all access.
    // If you add file uploads later (e.g. profile pictures), replace this
    // with per-user rules such as:
    //   match /users/{userId}/{allPaths=**} {
    //     allow read, write: if request.auth != null && request.auth.uid == userId;
    //   }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
